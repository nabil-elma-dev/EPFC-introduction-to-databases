-- Q14 : Différence entre (a) et (b)
-- (a) les identifiants de tous les fournisseurs
select id_s
from s;
-- (b) les identifiants des fournisseurs qui fournissent une pièce bleue
select distinct spj.id_s
from spj, p
where spj.id_p = p.id_p
and p.color='Blue';
-- SOLUTION avec IN : différence entre ces deux ensembles
select id_s
from s
where id_s not in (
	select distinct spj.id_s
	from spj, p
	where spj.id_p = p.id_p
	and p.color='Blue'
);

-- SOLUTION avec EXCEPT : différence entre ces deux ensembles
select id_s
from s
	EXCEPT
select spj.id_s
from spj, p
where spj.id_p = p.id_p
and p.color='Blue';


/*
5) Écrivez la requête qui détermine quels sont les joueurs qui ont marqué le plus de buts lors des tirs aux buts de ce tournoi. On affichera l’identifiant de ces joueurs.
*/

SELECT g.player_id
FROM goals g
WHERE g.type = 'p'
GROUP BY g.player_id
HAVING SUM(g.num_goals) >= ALL (SELECT SUM(g.num_goals)
                                FROM goals g
                                WHERE g.type = 'p'
                                GROUP BY g.player_id);


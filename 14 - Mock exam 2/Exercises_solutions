/*
1) Écrivez la requête permettant d’obtenir les dates des matchs de poule du Maroc (*Morocco*) et de la France (*France*).
*/

SELECT m.date
FROM matches m
         JOIN participations p ON m.match_id = p.match_id
         JOIN teams t ON t.team_id = p.team_id
WHERE m.type = 'P'
  AND (t.team_name = 'France' OR t.team_name = 'Morocco');


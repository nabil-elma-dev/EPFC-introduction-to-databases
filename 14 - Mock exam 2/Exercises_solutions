/*
3) Écrivez la requête permettant d’obtenir les poules lors desquelles il y a eu exactement quatre victoires. On affichera le nom de la poule. Indice : le résultat contient 2 lignes.
*/

SELECT t.pool
FROM participations p
         JOIN teams t ON t.team_id = p.team_id
         JOIN matches m ON m.match_id = p.match_id
WHERE m.type = 'p'
  AND p.points = 3
GROUP BY t.pool
HAVING COUNT(*) = 4;


/*
2) Écrivez la requête permettant d’obtenir les matchs de poule qui se sont terminés par une égalité. Pour rappel, les deux équipes reçoivent 1 point dans ce cas-là. Affichez le nom des deux équipes, ainsi que la poule du match. Indice : le résultat contient 10 lignes.
*/

SELECT t1.team_name, t2.team_name, t1.pool
FROM participations p1
         JOIN participations p2 ON p1.match_id = p2.match_id
         JOIN teams t1 ON t1.team_id = p1.team_id
         JOIN teams t2 ON t2.team_id = p2.team_id
WHERE p1.team_id < p2.team_id
  AND p2.points = 1;


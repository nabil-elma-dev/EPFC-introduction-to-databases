/* Quelques variantes correctes */
SELECT teams.pool
FROM teams, participations
WHERE teams.team_id = participations.team_id AND participations.points = 3
GROUP BY teams.pool
HAVING COUNT(*) = 4;
	
SELECT teams.pool
FROM teams, participations
WHERE participations.points > 1 AND participations.team_id=teams.team_id
GROUP BY teams.pool
HAVING SUM(participations.points) = 12;

SELECT DISTINCT teams.pool
FROM teams
JOIN participations ON participations.team_id = teams.team_id
GROUP BY participations.points, teams.pool
HAVING COUNT(participations.points = 3) = 4;

/* Cette dernière variante n'est pas tout a fait correcte car si les 6 matchs d'une poule se sont terminés par un match null, alors la somme des points est 12 aussi. */

SELECT t.pool
FROM teams t, participations p, matches m
WHERE t.team_id = p.team_id AND	p.match_id = m.match_id AND m.type = 'p'
GROUP BY t.pool, p.points
HAVING SUM(p.points) = '12';


/*
4) Écrivez la requête permettant d’afficher le nom des joueurs présents dans la base de données qui n’ont marqué <u>aucun</u> but en phase de poule. Indice : le résultat contient 40 lignes.
*/

SELECT p.player_name
FROM players p
WHERE p.player_id NOT IN (SELECT g.player_id
                          FROM goals g,
                               matches m
                          WHERE g.match_id = m.match_id
                            AND m.type = 'P');


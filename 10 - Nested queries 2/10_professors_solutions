-- Q1  : un fournisseur de Londres tel qu'il existe une livraison
--       de plus de 500 pièces faite par ce fournisseur
/* Smith */
select sname
from s
where s.city = 'London'
  and exists(	select *
				from spj
				where s.id_s = spj.id_s
				and qty>500 );



-- Q2
-- un projet pour lequel il existe un ensemble de livraison (à ce projet) dont la somme
-- des quantités dépasse 1000 unités.
/* Display Console RAID Tape */
SELECT jname
FROM j
WHERE EXISTS (
	SELECT *
	FROM spj
	WHERE spj.id_j = j.id_j
	GROUP BY id_j
	HAVING sum( qty ) >1000 );

-- Variante sans GROUP BY
SELECT J.JNAME
FROM J
WHERE EXISTS(
	SELECT *
	FROM SPJ
	WHERE SPJ.ID_J = J.ID_J
	HAVING SUM(SPJ.QTY) > 1000
);

-- Autre variante (sans EXISTS)

SELECT J.JNAME
FROM J
WHERE (
	SELECT SUM(SPJ.QTY)
	FROM SPJ
	WHERE SPJ.ID_J = J.ID_J
) > 1000;


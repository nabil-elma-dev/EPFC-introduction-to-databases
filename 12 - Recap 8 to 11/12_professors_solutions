-- Q11
-- Affichez tous les hamburgers sauf le plus calorique. (Tous sauf le Giga Burger)
select h.nom
from Hamburger h
where h.Calories <> (select max(Calories) from Hamburger);

-- ou --

select h.nom
from Hamburger h
where h.Calories < ANY (select Calories from Hamburger);

-- Q12
-- Quel est l'homme le plus lourd qui a mangé un hamburger de poulet ? (P3)
select distinct p.ID
from Personne p, Hamburger h, Mange m
where p.ID = m.ID_P
  and h.ID = m.ID_H
  and p.Sexe = 'M'
  and h.Genre = 'Poulet'
  and p.Poids = (
	select max(p.Poids)
	from Personne p, Hamburger h, Mange m
	where p.ID = m.ID_P
 	 and h.ID = m.ID_H
 	 and p.Sexe = 'M'
 	 and h.Genre = 'Poulet'
);


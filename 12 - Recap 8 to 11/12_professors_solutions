-- Q3
-- Quel est le nom des hamburgers et la moyenne des notes pour les hamburgers ayant été
-- mangés par au moins 3 personnes différentes ?
select h.nom, avg(m.note)
from Hamburger h, Mange m
where h.ID = m.ID_H
group by h.ID, h.nom
having count(DISTINCT m.ID_P) >= 3;
-- Bicky 6.75
-- Bicky Poulet Cheese 5,66

-- Q4
-- Quel est le nom des hamburgers et le nombre de personnes différentes les ayant mangé
-- pour les hamburgers dont la moyenne des notes est supérieure ou égale à 6 ?
select h.nom, count(DISTINCT m.ID_P)
from Hamburger h, Mange m
where h.ID = m.ID_H
group by h.ID, h.nom
having avg(m.note) >= 6;
-- Note : on peut grouper par h.nom car le schéma mentionne que le nom est unique
-- Bicky 4
-- Bicky Poulet 2
-- Mega Burger 1

-- Q5
-- Quel est le nom et le sexe des personnes qui ont mangé au moins 3 fois le même
-- hamburger ?
select distinct p.nom, p.sexe
from Personne p join Mange m on p.ID = m.ID_P
group by p.id, m.id_h, p.nom, p.sexe
having count(*) >= 3;
-- Note : on doit grouper ici par p.id car le nom d'une personne n'est pas unique
-- Lisa F

-- ou

select distinct nom, sexe from Personne
where id in
	(select id_p from mange
     			 group by id_p,id_h
     			 having count(*) >= 3
    );

-- ou encore

select distinct p.nom, p.sexe
from Hamburger h, Personne p
where (select count(*) from Mange m where m.ID_H = h.ID and p.ID = m.ID_P) >= 3;



